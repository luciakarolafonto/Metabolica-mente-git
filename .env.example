APP_NAME="Metabolica Mente A.S.D."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ============================================================
#  EMAIL
# ------------------------------------------------------------
#  ADESSO: MAIL_MAILER=log -> le mail NON partono davvero,
#  vengono scritte in storage/logs/laravel.log. Serve per provare
#  tutto il sito subito, senza configurare niente.
#
#  PER FARLE PARTIRE DAVVERO CON GMAIL, fai cosi:
#   1. Vai su https://myaccount.google.com/security e attiva
#      la "Verifica in due passaggi" sull'account Gmail dell'associazione.
#   2. Vai su https://myaccount.google.com/apppasswords e crea
#      una "Password per le app" (16 lettere, tipo: abcd efgh ijkl mnop).
#   3. Qui sotto: cambia MAIL_MAILER da "log" a "smtp",
#      scrivi la tua email in MAIL_USERNAME e in MAIL_FROM_ADDRESS,
#      e incolla la password per le app (SENZA SPAZI) in MAIL_PASSWORD.
#   4. Salva il file e riavvia il server (php artisan serve).
#
#  NON usare la password normale di Gmail: non funziona.
# ============================================================
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@metabolicamente.it"
MAIL_FROM_NAME="${APP_NAME}"

# Dove arrivano i messaggi del form contatti del sito
CONTACT_TO_ADDRESS="info@metabolicamente.it"

# ============================================================
#  DATI DELL'ASSOCIAZIONE (usati nel sito, nel coupon e nelle mail)
#  Cambia questi valori e cambiano ovunque, senza toccare il codice.
# ============================================================
ASD_TRAINER="Daniela"
ASD_TRAINER_FULL="Daniela — la Dani"
ASD_INSTAGRAM="ladani_di_camminata_metabolica"
ASD_WHATSAPP=
ASD_PHONE="+39 000 000 0000"
ASD_LOCATION="Boa Gialla Agribeach"
ASD_CITY=""
ASD_COUPON_VALUE="15"
ASD_COUPON_DAYS=30
